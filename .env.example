# RetireWise environment configuration template.
#
# Phase 0 status: no backend service, authentication, or AI provider
# integration exists yet, so none of these variables are read by any code
# in this repository today. This file exists to reserve the names that
# later phases will need (per docs/AI_ARCHITECTURE.md and
# docs/RELEASE_PLAN.md) so contributors know the expected shape of
# configuration up front.
#
# Copy this file to `.env` and fill in real values only once the phase
# that consumes them is implemented. Never commit a filled-in `.env`.

# Anthropic-backed AI model gateway (docs/AI_ARCHITECTURE.md section 10.6).
# Planned in: Phase 4 (AI integration).
ANTHROPIC_API_KEY=

# Backend datastore connection (docs/ARCHITECTURE.md, docs/DATA_MODEL.md).
# Planned in: Phase 1 (Backend foundation).
DATABASE_URL=

# Authentication provider configuration (docs/SECURITY.md section 23).
# Planned in: Phase 3 (Authentication).
AUTH_JWT_SIGNING_SECRET=
